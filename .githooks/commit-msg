#!/usr/bin/env bash
# Commit-msg hook: 拒绝 AI 工具把自身写入提交署名（Co-Authored-By / Generated with 等）。
#
# 安装：git config core.hooksPath .githooks

set -eu

MSG_FILE="${1:-}"
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0
[ -s "$MSG_FILE" ] || exit 0

# 只看提交信息本体：去掉注释行，以及 git commit --verbose 的 diff 段（剪刀线之后）。
if ! MESSAGE=$(git stripspace --strip-comments <"$MSG_FILE"); then
  echo "[commit-msg] 无法解析提交信息，拒绝提交" >&2
  exit 1
fi
[ -n "$MESSAGE" ] || exit 0

TRAILER='^[[:space:]]*(co-authored-by|co-author|assisted-by|generated-by|authored-by)[[:space:]]*:'
GENERATED='generated[[:space:]-]+(with|by)'

# 明确的 AI 工具/厂商标识，按整词匹配。`cody` 不在此列：它也是常见人名，
# 单独按「值就是 Cody」判定，避免把 "Cody Buffington" 这类完整人名拦掉。
AI_NAME='(claude|anthropic|codex|openai|chatgpt|gpt-[0-9][[:alnum:]._-]*|copilot|gemini|cursor|aider|devin|windsurf|cline|roo[ -]?code|opencode|sourcegraph|codebuff|freebuff)'
AI_WORD="(^|[^[:alnum:]])${AI_NAME}([^[:alnum:]]|$)"
CODY_WORD='(^|[^[:alnum:]])cody[[:space:]]*(\(|<|$)'
AI_HIT="(${AI_WORD}|${CODY_WORD})"

# grep 退出码 0=命中、1=无命中、2+=出错；只有 1 能当作「干净」放行。
scan() {
  local out rc
  set +e
  out=$(grep -Ein -- "$1" <<<"$MESSAGE")
  rc=$?
  set -e
  if [ "$rc" -gt 1 ]; then
    echo "[commit-msg] 校验器出错（grep 退出码 $rc），拒绝提交" >&2
    return "$rc"
  fi
  printf '%s' "$out"
}

# 1) 协作者/署名类 trailer：值里出现 AI 标识即拒绝。trailer 本身合法，人工署名放行。
HIT=$(scan "$TRAILER.*$AI_HIT")
if [ -n "$HIT" ]; then
  echo "[commit-msg] 拒绝提交：署名行包含 AI 工具标识" >&2
  echo "$HIT" | sed 's/^/  /' >&2
  echo "  作者只能是真实人类（git config user.name / user.email）。" >&2
  exit 1
fi

# 2) "Generated with <AI>" / "Generated by <AI>" / "🤖 Generated with ..." 式尾注。
HIT_GEN=$(scan "$GENERATED.*$AI_HIT")
if [ -n "$HIT_GEN" ]; then
  echo "[commit-msg] 拒绝提交：提交信息包含 AI 生成工具尾注" >&2
  echo "$HIT_GEN" | sed 's/^/  /' >&2
  exit 1
fi

# 3) codebuff / freebuff 变体：大小写、分隔符（code-buff / code buf）、单字符错拼。
#    只在署名行与生成行上判定；按 token 匹配并限制长度，避免跨词误伤人名。
FUZZY_HIT=$(awk '
function lev(a, b,    la, lb, i, j, d, c) {
  la = length(a); lb = length(b)
  if (la == 0) return lb
  if (lb == 0) return la
  for (i = 0; i <= la; i++) d[i, 0] = i
  for (j = 0; j <= lb; j++) d[0, j] = j
  for (i = 1; i <= la; i++) {
    for (j = 1; j <= lb; j++) {
      c = (substr(a, i, 1) == substr(b, j, 1)) ? 0 : 1
      d[i, j] = d[i-1, j] + 1
      if (d[i, j-1] + 1 < d[i, j]) d[i, j] = d[i, j-1] + 1
      if (d[i-1, j-1] + c < d[i, j]) d[i, j] = d[i-1, j-1] + c
    }
  }
  return d[la, lb]
}
BEGIN { targets[1] = "codebuff"; targets[2] = "freebuff" }
{
  line = $0
  sub(/\r$/, "", line)
  low = tolower(line)
  if (low !~ /^[[:space:]]*(co-authored-by|co-author|assisted-by|generated-by|authored-by)[[:space:]]*:/ &&
      low !~ /generated[[:space:]-]+(with|by)/) next
  n = 0
  ntok = split(low, raw, /[^a-z0-9]+/)
  for (k = 1; k <= ntok; k++) if (raw[k] != "") tok[++n] = raw[k]
  for (t = 1; t <= 2; t++) {
    target = targets[t]; tl = length(target)
    for (k = 1; k <= n; k++) {
      w = tok[k]
      if (length(w) >= tl - 1 && length(w) <= tl + 1 && lev(w, target) <= 1) {
        print NR": "line; exit
      }
      if (k < n) {
        w2 = tok[k] tok[k+1]
        if (length(w2) >= tl - 1 && length(w2) <= tl + 1 && lev(w2, target) <= 1) {
          print NR": "line; exit
        }
      }
    }
  }
}
' <<<"$MESSAGE")
if [ -n "$FUZZY_HIT" ]; then
  echo "[commit-msg] 拒绝提交：署名行包含 codebuff/freebuff（含变体）" >&2
  echo "$FUZZY_HIT" | sed 's/^/  /' >&2
  exit 1
fi

exit 0
