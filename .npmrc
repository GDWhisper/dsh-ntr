# Two generations of DSH packages coexist as TYPE-ONLY devDependencies:
# the 0.1.5-rc.x client/host family (browser + webserver types) and the
# 0.2.2-rc.5 subagent family (native subagent seam types). Their exact-pin
# peer trees conflict (e.g. dsh-brand 0.1.5-rc.2 vs 0.2.2-rc.5), while the
# plugin itself imports ZERO runtime values from either — the host profile
# provides every runtime module. Ignore peer resolution for this dev tree
# (the same posture as the host profile's pnpm autoInstallPeers=false);
# packages whose types we directly reference are pinned as explicit devDeps.
legacy-peer-deps=true